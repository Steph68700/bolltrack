server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  charset utf-8;
  server_tokens off;
  # Railway termine HTTPS en amont : conserver les redirections relatives.
  absolute_redirect off;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  gzip on;
  gzip_types text/css application/javascript application/json application/xml image/svg+xml;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }
  location = /boutique { return 302 /boutique.html; }
  location = /boutique/ { return 302 /boutique.html; }
  location = /magasin { return 302 /boutique.html; }
  location = /magasin/ { return 302 /boutique.html; }
  location ~ /\. { deny all; }
  location ~* \.(?:jpg|jpeg|png|svg|webp|gif|ico|ttf|woff2?|mp3|wav)$ {
    expires 7d;
    try_files $uri =404;
  }
  location / {
    try_files $uri $uri/ =404;
  }
}
